# Copy this file to .env and configure it. Never commit .env.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=migration_user
MYSQL_PASSWORD=replace_with_your_password

OLD_TDB_VERSION=335.11.39
NEW_TDB_VERSION=335.26091

AUTH_OLD_DATABASE=woi_auth
AUTH_NEW_DATABASE=dev_woi_auth
CHARACTERS_OLD_DATABASE=woi_characters
CHARACTERS_NEW_DATABASE=dev_woi_characters
WORLD_OLD_DATABASE=woi_world
WORLD_NEW_DATABASE=dev_woi_world

# Optional overrides, comma-separated. Use GROUP.table and GROUP.table.column.
# Example: CUSTOM_TABLES=AUTH.account_passhistory,WORLD.donation_items
# Example: CUSTOM_COLUMNS=AUTH.account.gmlevel,WORLD.game_event.eventEntry
CUSTOM_TABLES=
CUSTOM_COLUMNS=

# Old TrinityCore columns absent in the new baseline require explicit review.
# Example: IGNORED_CORE_COLUMNS=AUTH.realmlist.color,WORLD.creature.spawndist
IGNORED_CORE_COLUMNS=
